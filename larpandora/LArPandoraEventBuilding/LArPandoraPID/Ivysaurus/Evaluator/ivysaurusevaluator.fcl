  TrackVarManager:        @local::trackvar_manager
  ShowerVarManager:       @local::showervar_manager
  ContainedNetName:       "PandoraNet_IvyEvaluator_All_DUNEFD_HD_v1_0_0.pt"
  ExitingNetName:         "PandoraNet_IvyEvaluator_All_DUNEFD_HD_v1_0_0.pt"  
  NTrackVars:              20
  NShowerVars:             10
  RecoModuleLabel:        "pandora"
