  ShowerModuleLabel:      "pandoraShower"  
  FVMinX:                   -350.0    # FD HD
  FVMaxX:                    350.0    # FD HD
  FVMinY:                   -590.0    # FD HD
  FVMaxY:                    590.0    # FD HD
  FVMinZ:                    10.0     # FD HD
  FVMaxZ:                    1384.0   # FD HD
}

